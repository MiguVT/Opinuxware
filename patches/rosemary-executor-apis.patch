+fn class() -> &'static objc::class::Class {
+    static CLASS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let pointer = *CLASS.get_or_init(|| {
+        let class = corefoundation::base::register(c"__R3SSLContext", None, size_of::<Body>(), true);
+        class.replace_method(
+            objc::sel::get("dealloc"),
+            dealloc as *const c_void,
+            c"v16@0:8",
+        );
+        objc::class::ptr(class) as usize
+    });
+    // SAFETY: a class registered above and kept for the process.
+    unsafe {
+        objc::class::from_ptr(pointer as *const objc::class::Class).expect("an SSL context class")
+    }
+}
