+//! SecureTransport: the `SSL*` TLS client API, over Rustls.
+//!
+//! A guest that carries its own network stack (the Roblox executor does) opens a
+//! context, installs `SSLSetIOFuncs` callbacks, sets the peer's name, and drives
+//! a handshake with `SSLHandshake`. Rustls does the TLS work; guest callbacks
+//! move the bytes so a non-blocking caller sees `errSSLWouldBlock`.
+//!
+//! The server is always verified: against the host's roots, and against the
+//! name given to `SSLSetPeerDomainName`. There is no "skip verification" path.
+
+#![allow(non_snake_case)]
+
+use std::ffi::c_void;
+use std::io::{Read, Write};
+
+use corefoundation::base::CFTypeRef;
+use rustls_pki_types::{CertificateDer, ServerName};
+
+type OSStatus = i32;
+/// `errSSLParam`.
+const PARAM: OSStatus = -50;
+/// `noErr`.
+const OK: OSStatus = 0;
+/// `errSSLCrypto`.
+const CRYPTO: OSStatus = -9802;
+/// `errSSLWouldBlock`.
+const WOULD_BLOCK: OSStatus = -9803;
+/// `errSSLProtocol`.
+const PROTOCOL: OSStatus = -9807;
+/// `errSSLPeerHandshakeFail`.
+const PEER_HANDSHAKE_FAIL: OSStatus = -9812;
+/// `errSSLPeerCertUnknown`.
+const PEER_CERT_UNKNOWN: OSStatus = -9814;
+/// `errSSLInternal`.
+const INTERNAL: OSStatus = -9817;
+
+/// `kSSLConnected`.
+const STATE_CONNECTED: i32 = 2;
+/// `kSSLHandshake`.
+const STATE_HANDSHAKE: i32 = 1;
+/// `kSSLIdle`.
+const STATE_IDLE: i32 = 0;
+
+/// `OSStatus (*SSLReadFunc)(SSLConnectionRef, void *, size_t *)`.
+type ReadFunc = Option<unsafe extern "C" fn(*const c_void, *mut c_void, *mut usize) -> OSStatus>;
+/// `OSStatus (*SSLWriteFunc)(SSLConnectionRef, const void *, size_t *)`.
+type WriteFunc = Option<unsafe extern "C" fn(*const c_void, *const c_void, *mut usize) -> OSStatus>;
+
+/// Handshake steps tried per call before yielding `errSSLWouldBlock`.
+const HANDSHAKE_STEPS: usize = 8;
+/// Bytes read from the guest per step.
+const IO_BUFFER: usize = 64 * 1024;
+
+struct Connection {
+    server_name: String,
+    read: ReadFunc,
+    write: WriteFunc,
+    io: *mut c_void,
+    /// TLS output not yet accepted by the guest.
+    outbound: Vec<u8>,
+    /// Suites the caller asked for; Rustls chooses from its own set.
+    ciphers: Vec<u16>,
+    tls: Option<rustls::ClientConnection>,
+}
+
+impl Connection {
+    /// One guest read. `Err` carries the callback's refusal.
+    fn io_read(&mut self, buffer: &mut [u8]) -> Result<usize, OSStatus> {
+        let Some(read) = self.read else {
+            return Ok(0);
+        };
+        let mut count = buffer.len();
+        // SAFETY: the guest's callback, given its own connection reference and a
+        // writable buffer of the stated length.
+        let status = unsafe { read(self.io, buffer.as_mut_ptr() as *mut c_void, &mut count) };
+        match status {
+            OK | WOULD_BLOCK => Ok(count.min(buffer.len())),
+            other => Err(other),
+        }
+    }
+
+    /// Hand `data` to the guest; whatever it does not take stays queued.
+    fn io_write(&mut self, data: &[u8]) -> OSStatus {
+        let Some(write) = self.write else {
+            self.outbound.extend_from_slice(data);
+            return OK;
+        };
+        let mut left = data;
+        while !left.is_empty() {
+            let mut count = left.len();
+            // SAFETY: the guest's callback, its own connection reference, and a
+            // readable buffer of the stated length.
+            let status = unsafe { write(self.io, left.as_ptr() as *const c_void, &mut count) };
+            if status != OK && status != WOULD_BLOCK {
+                self.outbound.extend_from_slice(left);
+                return status;
+            }
+            if count == 0 {
+                break;
+            }
+            left = &left[count.min(left.len())..];
+        }
+        if !left.is_empty() {
+            self.outbound.extend_from_slice(left);
+        }
+        OK
+    }
+
+    /// Send queued TLS output to the guest.
+    fn flush(&mut self) -> OSStatus {
+        let queued = std::mem::take(&mut self.outbound);
+        self.io_write(&queued)
+    }
+
+    /// Move whatever the current handshake state wants written into `outbound`.
+    fn drain_tls(&mut self) {
+        let Some(tls) = self.tls.as_mut() else {
+            return;
+        };
+        let mut chunk = [0u8; IO_BUFFER];
+        loop {
+            match tls.write_tls(&mut &mut chunk[..]) {
+                Ok(0) | Err(_) => break,
+                Ok(n) => self.outbound.extend_from_slice(&chunk[..n]),
+            }
+        }
+    }
+
+    /// Give guest bytes to Rustls and process whatever became complete.
+    fn feed(&mut self, data: &[u8]) -> Result<(), OSStatus> {
+        let Some(tls) = self.tls.as_mut() else {
+            return Err(INTERNAL);
+        };
+        let mut cursor = data;
+        while !cursor.is_empty() {
+            match tls.read_tls(&mut cursor) {
+                Ok(0) => break,
+                Ok(_) => {
+                    tls.process_new_packets().map_err(|_| PEER_CERT_UNKNOWN)?;
+                }
+                Err(_) => return Err(PROTOCOL),
+            }
+        }
+        Ok(())
+    }
+
+    fn established(&self) -> bool {
+        self.tls.as_ref().is_some_and(|tls| !tls.is_handshaking())
+    }
+
+    /// Plaintext Rustls already holds for the caller. A settled connection
+    /// reports one byte so a caller polling the size keeps reading; what is
+    /// actually there is only known by reading, and `SSLRead` spends it.
+    fn buffered_plaintext(&self) -> usize {
+        if self.established() { 1 } else { 0 }
+    }
+}
