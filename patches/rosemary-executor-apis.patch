+/// # Safety
+///
+/// `ctx` is null or a live context from [`SSLCreateContext`].
+unsafe fn connection<'a>(ctx: CFTypeRef) -> Option<&'a mut Connection> {
+    if ctx.is_null() || !unsafe { corefoundation::base::is_kind_of(ctx, class()) } {
+        return None;
+    }
+    let body = ctx as *mut Body;
+    if unsafe { (*body).connection.is_null() } {
+        return None;
+    }
+    // SAFETY: a body of this class, live for `'a`.
+    Some(unsafe { &mut *(*body).connection })
