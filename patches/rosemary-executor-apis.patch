+/// its descriptor and its offset as the real call leaves them.
+///
+/// # Safety
+///
+/// `fd` is a descriptor the guest holds.
+unsafe fn borrowed_source(fd: c_int) -> Option<std::fs::File> {
+    // SAFETY: the caller's descriptor.
+    let file = unsafe { <std::fs::File as std::os::fd::FromRawFd>::from_raw_fd(fd) };
+    let file = std::mem::ManuallyDrop::new(file);
+    // SAFETY: an open descriptor, read through a borrow of the handle that owns
+    // it; `try_clone` makes a new descriptor the returned `File` owns.
+    match unsafe { file.try_clone() } {
+        Ok(clone) => Some(clone),
+        Err(error) => {
+            crate::errno::set(error.raw_os_error().unwrap_or(libc::EBADF));
+            None
+        }
+    }
+}
