+/// `OSStatus SSLHandshake(SSLContextRef)`.
+///
+/// Creates the connection on the first call, then pumps it. Returns
+/// `errSSLWouldBlock` while the transport has nothing new, which is what a
+/// caller loops on.
+///
+/// # Safety
+///
+/// `ctx` is null or a live context.
+pub unsafe extern "C" fn SSLHandshake(ctx: CFTypeRef) -> OSStatus {
+    // SAFETY: the caller's guarantee.
+    let Some(connection) = (unsafe { connection(ctx) }) else {
+        return PARAM;
+    };
+
+    if connection.tls.is_none() {
+        let Ok(name) = ServerName::try_from(connection.server_name.clone()) else {
+            return PEER_HANDSHAKE_FAIL;
+        };
+        match rustls::ClientConnection::new(config().clone(), name) {
+            Ok(tls) => connection.tls = Some(tls),
+            Err(_) => return INTERNAL,
+        }
+    }
+
+    connection.drain_tls();
+    let mut status = connection.flush();
+    if status != OK {
+        return status;
+    }
+
+    for _ in 0..HANDSHAKE_STEPS {
+        if connection.established() {
+            return OK;
+        }
+        let mut buffer = [0u8; IO_BUFFER];
+        let read = match connection.io_read(&mut buffer) {
+            Ok(read) => read,
+            Err(code) => return code,
+        };
+        if read == 0 {
+            return WOULD_BLOCK;
+        }
+        if let Err(code) = connection.feed(&buffer[..read]) {
+            return code;
+        }
+        connection.drain_tls();
+        status = connection.flush();
+        if status != OK {
+            return status;
+        }
+    }
+
+    if connection.established() {
+        OK
+    } else {
+        WOULD_BLOCK
+    }
+}
