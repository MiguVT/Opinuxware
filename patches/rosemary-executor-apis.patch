+fn new_handle(connection: Connection) -> CFTypeRef {
+    // SAFETY: `Body` is the registered layout.
+    let body = unsafe { corefoundation::base::allocate::<Body>(class()) };
+    if body.is_null() {
+        return std::ptr::null();
+    }
+    // SAFETY: a freshly allocated body, written once before publication.
+    unsafe { (*body).connection = Box::into_raw(Box::new(connection)) };
+    body as CFTypeRef
+}
