+/// `int fclonefileat(int src_fd, int dst_dirfd, const char *dst, uint32_t flags)`.
+///
+/// A copy is what a clone is for every caller that matters: the result is a
+/// complete file with the source's contents. Nothing records that the two
+/// share clusters, so a later write does not copy-on-write, but the file the
+/// caller asked for exists and is whole - `0` on success, `-1` with `errno`
+/// otherwise, like the real one.
+///
+/// # Safety
+///
+/// `dst` is a NUL-terminated path.
+pub unsafe extern "C" fn fclonefileat(
+    src_fd: c_int,
+    dst_dirfd: c_int,
+    dst: *const c_char,
+    flags: u32,
+) -> c_int {
+    // CLONE_NOFOLLOW keeps a final symlink un-followed; nothing else is defined.
+    const CLONE_NOFOLLOW: u32 = 0x1;
+    // CLONE_NOOWNERCOPY leaves the copy owned by the caller.
+    const CLONE_NOOWNERCOPY: u32 = 0x2;
+
+    // Only `CLONE_NOFOLLOW` and `CLONE_NOOWNERCOPY` are defined; any other bit
+    // is a caller error, as on a Mac.
+    const KNOWN: u32 = CLONE_NOFOLLOW | CLONE_NOOWNERCOPY;
+    if flags & !KNOWN != 0 {
+        crate::errno::set(libc::EINVAL);
+        return -1;
+    }
+    let Some(dst) = host(dst) else {
+        crate::errno::set(libc::EFAULT);
+        return -1;
+    };
+    let dst = std::path::PathBuf::from(std::ffi::OsStr::from_bytes(dst.as_bytes()));
+    // Resolve the destination relative to `dst_dirfd`, which is what the
+    // `...at` spelling means; an absolute destination ignores it.
+    let target = if dst.is_absolute() {
+        dst
+    } else if dst_dirfd == libc::AT_FDCWD {
+        std::env::current_dir()
+            .map(|cwd| cwd.join(&dst))
+            .unwrap_or(dst)
+    } else {
+        match std::fs::read_link(format!("/proc/self/fd/{dst_dirfd}")) {
+            Ok(dir) => dir.join(&dst),
+            Err(_) => {
+                crate::errno::set(libc::EBADF);
+                return -1;
+            }
+        }
+    };
+
+    // SAFETY: the caller handed a live descriptor.
+    let mut source = match unsafe { borrowed_source(src_fd) } {
+        Some(source) => source,
+        None => return -1,
+    };
+    let mut output = match std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&target)
+    {
+        Ok(output) => output,
+        Err(error) => {
+            crate::errno::set(error.raw_os_error().unwrap_or(libc::EIO));
+            return -1;
+        }
+    };
+    match std::io::copy(&mut source, &mut output) {
+        Ok(_) => 0,
+        Err(error) => {
+            let _ = std::fs::remove_file(&target);
+            crate::errno::set(error.raw_os_error().unwrap_or(libc::EIO));
+            -1
+        }
+    }
+}
