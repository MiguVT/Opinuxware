+/// `OSStatus SSLClose(SSLContextRef)`.
+///
+/// # Safety
+///
+/// `ctx` is null or a live context.
+pub unsafe extern "C" fn SSLClose(ctx: CFTypeRef) -> OSStatus {
+    // SAFETY: the caller's guarantee.
+    let Some(connection) = (unsafe { connection(ctx) }) else {
+        return PARAM;
+    };
+    if let Some(tls) = connection.tls.as_mut() {
+        tls.send_close_notify();
+    }
+    connection.drain_tls();
+    let _ = connection.flush();
+    OK
+}
