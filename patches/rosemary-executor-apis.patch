+pub unsafe extern "C" fn CFUserNotificationCreate(
+    _allocator: CFTypeRef,
+    _timeout: f64,
+    _flags: u64,
+    out_error: *mut i32,
+    _dictionary: CFTypeRef,
+) -> CFTypeRef {
