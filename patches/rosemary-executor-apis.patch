+/// Fill the contents word of a live `Body<T>`, as an `-init` does to the
+/// object `alloc` returned.
+///
+/// # Safety
+///
+/// `object` is a live instance of the class [`register`] made for `T`; its
+/// contents word is null or a box this module's allocator made (a fresh
+/// `class_createInstance` is zeroed, so a single `-init` finds null).
+pub unsafe fn place_contents<T>(object: CFTypeRef, contents: T) {
+    let body = object as *mut Body<T>;
+    if !(*body).contents.is_null() {
+        // SAFETY: a box this module's allocator made, per the caller; a second
+        // `-init` replaces the first's state, which is what Apple's does too.
+        drop(Box::from_raw((*body).contents));
+    }
+    // SAFETY: a fresh box, kept for the object's lifetime by `-dealloc`.
+    (*body).contents = Box::into_raw(Box::new(contents));
+}
+
