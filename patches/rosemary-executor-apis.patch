+    connection.drain_tls();
+    let status = connection.flush();
+    if status != OK {
+        return status;
+    }
+
+    if !processed.is_null() {
+        // SAFETY: writable, per the caller.
+        unsafe { processed.write(written) };
+    }
+    if written == bytes.len() {
+        OK
+    } else {
+        WOULD_BLOCK
+    }
