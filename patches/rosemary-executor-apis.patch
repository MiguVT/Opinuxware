+/// Ask the guest's `WKURLSchemeHandler` for `url`, and show what it answers.
+///
+/// On macOS the guest registers a handler per custom scheme (`tauri://`
+/// here) and WebKit calls `-webView:startURLSchemeTask:`; the handler then
+/// answers the task with a response and the body. This runtime stands in for
+/// that WebKit: it makes the task itself, hands it to the guest's handler, and
+/// loads the task's HTML into the widget. Returns whether a handler took it.
+///
+/// # Safety
+///
+/// `receiver` is a live web view.
+unsafe fn serve_custom_scheme(receiver: Id, url: &str) -> bool {
+    let Some((scheme, _)) = url.split_once("://") else {
+        return false;
+    };
+    if matches!(scheme, "file" | "http" | "https" | "about" | "data") {
+        return false;
+    }
+    let Some((engine, gtk)) = gtk_of(receiver) else {
+        return false;
+    };
+    let Some((_, _, configuration)) = parts_of(receiver) else {
+        return false;
+    };
+    // SAFETY: a live configuration; null when no handler claimed `scheme`.
+    let handler = unsafe {
+        send!(
+            configuration,
+            "urlSchemeHandlerForURLScheme:",
+            foundation::string::from_str(scheme) => Id; Id
+        )
+    };
+    if handler.is_null() {
+        return false;
+    }
+
+    let task = scheme_task(url);
+    // SAFETY: a handler object the guest registered answers the protocol.
+    unsafe {
+        send!(handler, "webView:startURLSchemeTask:",
+            receiver => Id, task => Id; ())
+    };
+    match scheme_task_body(task) {
+        Some(body) => {
+            let html = gtk::c_string(&body);
+            let base = gtk::c_string(&servable_base(url));
+            // SAFETY: the view's widget and two strings it copies.
+            unsafe { (engine.api.webkit_web_view_load_html)(gtk, html.as_ptr(), base.as_ptr()) };
+        }
+        None => engine::warn_once(&format!("no response from the handler for {scheme}://")),
+    }
+    true
+}
