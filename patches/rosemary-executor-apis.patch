+unsafe extern "C" fn dealloc(receiver: objc::object::Id, _sel: objc::sel::Sel) {
+    // SAFETY: this class's layout, and the connection `SSLCreateContext` boxed.
+    unsafe {
+        let body = receiver as *mut Body;
+        if !(*body).connection.is_null() {
+            drop(Box::from_raw((*body).connection));
+        }
+        objc::arc::finalize(receiver);
+    }
+}
