+/// `OSStatus SSLGetSessionState(SSLContextRef, SSLSessionState *)`.
+///
+/// # Safety
+///
+/// `ctx` is null or a live context; `state` is null or writable.
+pub unsafe extern "C" fn SSLGetSessionState(ctx: CFTypeRef, state: *mut i32) -> OSStatus {
+    // SAFETY: the caller's guarantee.
+    let Some(connection) = (unsafe { connection(ctx) }) else {
+        return PARAM;
+    };
+    if !state.is_null() {
+        let value = match connection.tls.as_ref() {
+            None => STATE_IDLE,
+            Some(tls) if tls.is_handshaking() => STATE_HANDSHAKE,
+            Some(_) => STATE_CONNECTED,
+        };
+        // SAFETY: writable, per the caller.
+        unsafe { state.write(value) };
+    }
+    OK
+}
