+/// `-loadHTMLString:baseURL:`.
+///
+/// wry loads the window's first page this way when no custom scheme is
+/// registered. The base URL is what relative resources resolve against; it is
+/// passed to the engine as the document's own URL.
+/// The base URL a custom-scheme document is loaded against.
+///
+/// WebKitGTK will not load `tauri://localhost` (or any other scheme it has no
+/// handler for), while on macOS the guest's own `WKURLSchemeHandler` serves it.
+/// This runtime's content lives in the guest's filesystem under the bundle's
+/// `_up_` asset directory, so the scheme's origin becomes a `file:` URL there:
+/// relative resources resolve the same way and the page loads at all.
+fn servable_base(url: &str) -> String {
+    const ASSETS: &str = "/Contents/Resources/_up_";
+    // The scheme is whatever precedes `://`; WebKit rejects the unknown ones.
+    let Some((scheme, rest)) = url.split_once("://") else {
+        return host_url(url);
+    };
+    // A `file:` or `http(s)` URL is one WebKitGTK already loads.
+    if matches!(scheme, "file" | "http" | "https" | "about" | "data") {
+        return host_url(url);
+    }
+    let guest_dir = match bare_guest_executable() {
+        Some(path) => format!("{path}{ASSETS}"),
+        None => format!("/Applications/Opiumware.app{ASSETS}"),
+    };
+    let host_dir = prefix::ns::host_path(&guest_dir);
+    let rest = rest.trim_start_matches('/');
+    match rest.is_empty() {
+        true => format!("file://{}/", host_dir.display()),
+        false => format!("file://{}/{rest}", host_dir.display()),
+    }
+}
+
+/// The guest path of the running executable's bundle directory, when it is in
+/// an `.app`.
+fn bare_guest_executable() -> Option<String> {
+    let executable = std::env::current_exe().ok()?;
+    let host = executable.to_string_lossy();
+    let guest = prefix::ns::to_guest(std::path::Path::new(host.as_ref()))?;
+    let guest = guest.to_string_lossy().into_owned();
+    // Names are `.../Foo.app/Contents/MacOS/Foo`.
+    let bundle = guest.split("/Contents/MacOS/").next()?;
+    bundle.ends_with(".app").then(|| bundle.to_string())
+}
+
+unsafe extern "C" fn load_html_string(receiver: Id, _sel: Sel, html: Id, base: Id) -> Id {
+    let (Some(engine), Some((_, gtk, _))) = (engine::get(), parts_of(receiver)) else {
+        return std::ptr::null_mut();
+    };
+    let base = match base.is_null() {
+        true => String::new(),
+        // SAFETY: an `NSURL`.
+        false => engine::text_of(unsafe { send!(base, "absoluteString"; Id) }),
+    };
+    // SAFETY: null or an `NSString`.
+    let html_text = engine::text_of(html);
+    let html = gtk::c_string(&html_text);
+    let base = gtk::c_string(&servable_base(&base));
+    // SAFETY: the view's widget and two strings it copies.
+    unsafe { (engine.api.webkit_web_view_load_html)(gtk, html.as_ptr(), base.as_ptr()) };
+    new_navigation()
+}
