+/// Read plaintext Rustls already produced, returning how much.
+fn read_plaintext(connection: &mut Connection, buffer: &mut [u8]) -> usize {
+    let Some(tls) = connection.tls.as_mut() else {
+        return 0;
+    };
+    let mut written = 0;
+    while written < buffer.len() {
+        match tls.reader().read(&mut buffer[written..]) {
+            Ok(0) => break,
+            Ok(n) => written += n,
+            Err(_) => break,
+        }
+    }
+    written
+}
