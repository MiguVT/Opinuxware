+fn roots() -> &'static std::sync::Arc<rustls::RootCertStore> {
+    static ROOTS: std::sync::OnceLock<std::sync::Arc<rustls::RootCertStore>> =
+        std::sync::OnceLock::new();
+    ROOTS.get_or_init(|| {
+        use rustls_pki_types::pem::PemObject;
+        const BUNDLES: &[&str] = &[
+            "/etc/ssl/certs/ca-certificates.crt",
+            "/etc/pki/tls/certs/ca-bundle.crt",
+            "/etc/ssl/ca-bundle.pem",
+            "/etc/ssl/cert.pem",
+            "/usr/local/share/certs/ca-root-nss.crt",
+        ];
+        let named = std::env::var_os("SSL_CERT_FILE").map(std::path::PathBuf::from);
+        let pem = named
+            .into_iter()
+            .chain(BUNDLES.iter().map(std::path::PathBuf::from))
+            .find_map(|path| std::fs::read(path).ok())
+            .unwrap_or_default();
+        let mut store = rustls::RootCertStore::empty();
+        for der in CertificateDer::pem_slice_iter(&pem).filter_map(Result::ok) {
+            let _ = store.add(der);
+        }
+        std::sync::Arc::new(store)
+    })
+}
