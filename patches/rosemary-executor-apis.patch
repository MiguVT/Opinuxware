+/// The `WKURLSchemeTask` objects made for the loads in flight.
+///
+/// WebKit's task is an opaque object the handler answers; this runtime keeps
+/// the answer beside the object, keyed by address.
+static SCHEME_TASKS: std::sync::Mutex<Vec<(usize, SchemeTask)>> = std::sync::Mutex::new(Vec::new());
+
+/// What a handler answered a task with.
+#[derive(Default, Clone)]
+struct SchemeTask {
+    body: Option<Vec<u8>>,
+    status: Option<i64>,
+    mime: Option<String>,
+    /// The `NSURLRequest` the task was made for, retained.
+    request: usize,
+}
+
+/// The class of the opaque task objects.
+fn scheme_task_class() -> &'static Class {
+    static CLASS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let at = *CLASS.get_or_init(|| {
+        let class = corefoundation::base::abstract_class(c"WKURLSchemeTask", None);
+        objc::class::ptr(class) as usize
+    });
+    // SAFETY: a class registered above and kept for the process.
+    unsafe { &*(at as *const Class) }
+}
+
+/// A task for `url`, registered so the handler's answers can find it.
+fn scheme_task(url: &str) -> Id {
+    let class = scheme_task_class();
+    let task = objc::object::create_instance(class, 0);
+    // The task's `-request` is the one that was asked for, so a handler that
+    // reads the URL sees the custom scheme it was told about.
+    let text = foundation::string::from_str(url);
+    // SAFETY: `+URLWithString:` and `+requestWithURL:` answer live objects.
+    let ns_url = unsafe {
+        send!(
+            objc::class::ptr(objc::class::lookup(c"NSURL").expect("Foundation")) as Id,
+            "URLWithString:", text => Id; Id
+        )
+    };
+    let request = unsafe {
+        send!(
+            objc::class::ptr(objc::class::lookup(c"NSMutableURLRequest").expect("Foundation")) as Id,
+            "requestWithURL:", ns_url => Id; Id
+        )
+    };
+    let request = objc::arc::retain(request) as usize;
+    SCHEME_TASKS
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .push((
+            task as usize,
+            SchemeTask {
+                request,
+                ..SchemeTask::default()
+            },
+        ));
+    task
+}
+
+/// The body a handler answered `task` with.
+fn scheme_task_body(task: Id) -> Option<String> {
+    let entry = SCHEME_TASKS
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .iter()
+        .find(|(key, _)| *key == task as usize)
+        .map(|(_, answer)| answer.clone());
+    // SAFETY: an `NSData` the handler wrote, read through Foundation.
+    entry.and_then(|answer| answer.body).map(|bytes| String::from_utf8_lossy(&bytes).into_owned())
+}
+
+/// Record what a handler answered, for the objects it answers on.
+pub(crate) fn note_scheme_answer(
+    task: Id,
+    status: Option<i64>,
+    mime: Option<String>,
+    body: Option<Vec<u8>>,
+) {
+    let mut tasks = SCHEME_TASKS.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((_, answer)) = tasks.iter_mut().find(|(key, _)| *key == task as usize) {
+        answer.status = status.or(answer.status);
+        answer.mime = mime.or(answer.mime.take());
+        if body.is_some() {
+            answer.body = body;
+        }
+    }
+}
+
+/// `OSStatus`-style helpers for the task: `-didReceiveResponse:`,
+/// `-didReceiveData:` and `-didFinish`.
+unsafe extern "C" fn task_did_receive_response(_receiver: Id, _sel: Sel, response: Id) {
+    let status = unsafe { send!(response, "statusCode"; i64) };
+    let mime = unsafe {
+        send!(objc::class::ptr(objc::class::lookup(c"NSString").expect("Foundation")) as Id, "stringWithUTF8String:", c"Content-Type".as_ptr() => *const c_char; Id)
+    };
+    let _ = mime;
+    note_scheme_answer(_receiver, Some(status), None, None);
+}
+
+unsafe extern "C" fn task_did_receive_data(receiver: Id, _sel: Sel, data: Id) {
+    // SAFETY: an `NSData` the handler wrote.
+    let bytes = unsafe {
+        let length = send!(data, "length"; usize);
+        let base = send!(data, "bytes"; *const u8);
+        match base.is_null() || length == 0 {
+            true => Vec::new(),
+            false => std::slice::from_raw_parts(base, length).to_vec(),
+        }
+    };
+    note_scheme_answer(receiver, None, None, Some(bytes));
+}
+
+unsafe extern "C" fn task_did_finish(receiver: Id, _sel: Sel) {
+    note_scheme_answer(receiver, None, None, None);
+}
+
+unsafe extern "C" fn task_did_fail(_receiver: Id, _sel: Sel, _error: Id) {}
+
+unsafe extern "C" fn task_request(receiver: Id, _sel: Sel) -> Id {
+    SCHEME_TASKS
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .iter()
+        .find(|(key, _)| *key == receiver as usize)
+        .map_or(std::ptr::null_mut(), |(_, answer)| answer.request as Id)
+}
+
+/// Install the task's methods.
+pub(crate) fn install_scheme_task() {
+    let class = scheme_task_class();
+    crate::methods!(class, {
+        "didReceiveResponse:" => task_did_receive_response, c"v24@0:8@16";
+        "didReceiveData:" => task_did_receive_data, c"v24@0:8@16";
+        "didFinish" => task_did_finish, c"v16@0:8";
+        "didFailWithError:" => task_did_fail, c"v24@0:8@16";
+        "request" => task_request, c"@16@0:8";
+    });
+}
