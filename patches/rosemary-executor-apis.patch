diff --git a/crates/appkit/src/protocols.rs b/crates/appkit/src/protocols.rs
new file mode 100644
index 0000000..73d0470
--- /dev/null
+++ b/crates/appkit/src/protocols.rs
@@ -0,0 +1,44 @@
+//! The Objective-C protocols AppKit's classes declare they conform to.
+//!
+//! A guest that subclasses `NSView` asks for `NSTextInputClient` by name and
+//! adopts it (`tao`, which Roblox's executor links, does exactly this). The
+//! methods are this crate's; what this module adds is the protocol object that
+//! names them, so a guest's lookup succeeds.
+
+use std::ffi::CStr;
+
+/// The instance methods an `NSTextInputClient` must answer, as
+/// `(selector, type encoding)`.
+const TEXT_INPUT_CLIENT: &[(&str, &CStr)] = &[
+    ("insertText:replacementRange:", c"v40@0:8@16{_NSRange=QQ}24"),
+    ("doCommandBySelector:", c"v24@0:8:16"),
+    ("setMarkedText:selectedRange:replacementRange:", c"v56@0:8@16{_NSRange=QQ}24{_NSRange=QQ}40"),
+    ("unmarkText", c"v16@0:8"),
+    ("hasMarkedText", c"c16@0:8"),
+    ("markedRange", c"{_NSRange=QQ}16@0:8"),
+    ("selectedRange", c"{_NSRange=QQ}16@0:8"),
+    ("validAttributesForMarkedText", c"@16@0:8"),
+    ("attributedSubstringForProposedRange:actualRange:", c"@48@0:8{_NSRange=QQ}16^{_NSRange=QQ}32"),
+    ("firstRectForCharacterRange:actualRange:", c"{CGRect={CGPoint=dd}{CGSize=dd}}48@0:8{_NSRange=QQ}16^{_NSRange=QQ}32"),
+    ("characterIndexForPoint:", c"Q32@0:8{CGPoint=dd}16"),
+];
+
+/// Declare and register the protocols a guest may look up.
+pub fn install() {
+    let Some(protocol) = objc::protocol::allocate(c"NSTextInputClient") else {
+        return;
+    };
+    for (selector, types) in TEXT_INPUT_CLIENT {
+        // Optional in the real protocol for the last three; a guest only looks
+        // the method up when it means to call it.
+        let required = !matches!(
+            *selector,
+            "validAttributesForMarkedText"
+                | "attributedSubstringForProposedRange:actualRange:"
+                | "firstRectForCharacterRange:actualRange:"
+                | "characterIndexForPoint:"
+        );
+        protocol.add_method(objc::sel::get(selector), types, required, true);
+    }
+    objc::protocol::register(protocol);
+}
