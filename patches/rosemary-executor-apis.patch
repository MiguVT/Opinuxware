+/// `void CFArrayGetValues(CFArrayRef, CFRange, const void **)`.
+///
+/// The range is a start and a length; both are clamped to the array, and only
+/// the values inside it are written.
+///
+/// # Safety
+///
+/// `values` is writable for as many entries as the clamped range holds.
+pub unsafe extern "C" fn CFArrayGetValues(array: CFTypeRef, range: CFRange, values: *mut CFTypeRef) {
+    if values.is_null() {
+        return;
+    }
+    let Some(a) = (unsafe { collections::array(array) }) else {
+        return;
+    };
+    let start = range.location.max(0) as usize;
+    let length = range.length.max(0) as usize;
+    if start >= a.values.len() {
+        return;
+    }
+    let end = (start + length).min(a.values.len());
+    for (i, value) in a.values[start..end].iter().enumerate() {
+        // SAFETY: writable for the clamped range, per the caller.
+        unsafe { values.add(i).write(*value) };
+    }
+}
