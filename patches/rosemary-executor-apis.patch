+/// description so a caller that logs one sees something meaningful.
+///
+/// # Safety
+///
+/// `domain` is null or a live string; `user_info` is null or a dictionary.
+pub unsafe extern "C" fn CFErrorCreate(
+    _allocator: CFTypeRef,
+    domain: CFTypeRef,
+    code: i64,
+    user_info: CFTypeRef,
+) -> CFTypeRef {
+    let domain = if domain.is_null() {
+        string::immortal("CFErrorDomain")
+    } else {
