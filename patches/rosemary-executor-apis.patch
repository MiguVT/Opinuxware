+/// `OSStatus SSLRead(SSLContextRef, void *, size_t, size_t *)`.
+///
+/// # Safety
+///
+/// `ctx` is null or a live context; `data` is writable for `length` bytes;
+/// `processed` is null or writable.
+pub unsafe extern "C" fn SSLRead(
+    ctx: CFTypeRef,
+    data: *mut c_void,
+    length: usize,
+    processed: *mut usize,
+) -> OSStatus {
+    // SAFETY: the caller's guarantee.
+    let Some(connection) = (unsafe { connection(ctx) }) else {
+        return PARAM;
+    };
+    if !processed.is_null() {
+        // SAFETY: writable, per the caller.
+        unsafe { processed.write(0) };
+    }
+    if data.is_null() || length == 0 {
+        return PARAM;
+    }
+    // SAFETY: writable for `length`, per the caller.
+    let buffer = unsafe { std::slice::from_raw_parts_mut(data as *mut u8, length) };
+
+    let mut written = read_plaintext(connection, buffer);
+    if written == 0 {
+        let mut wire = [0u8; IO_BUFFER];
+        let read = match connection.io_read(&mut wire) {
+            Ok(read) => read,
+            Err(code) => return code,
+        };
+        if read == 0 {
+            return WOULD_BLOCK;
+        }
+        if let Err(code) = connection.feed(&wire[..read]) {
+            return code;
+        }
+        connection.drain_tls();
+        let status = connection.flush();
+        if status != OK {
+            return status;
+        }
+        written = read_plaintext(connection, buffer);
+    }
+
+    if !processed.is_null() {
+        // SAFETY: writable, per the caller.
+        unsafe { processed.write(written) };
+    }
+    if written == 0 {
+        WOULD_BLOCK
+    } else {
+        OK
+    }
+}
+
+/// `OSStatus SSLWrite(SSLContextRef, const void *, size_t, size_t *)`.
+///
+/// # Safety
+///
+/// `ctx` is null or a live context; `data` is readable for `length` bytes;
+/// `processed` is null or writable.
+pub unsafe extern "C" fn SSLWrite(
+    ctx: CFTypeRef,
+    data: *const c_void,
+    length: usize,
+    processed: *mut usize,
+) -> OSStatus {
+    // SAFETY: the caller's guarantee.
+    let Some(connection) = (unsafe { connection(ctx) }) else {
+        return PARAM;
+    };
+    if !processed.is_null() {
+        // SAFETY: writable, per the caller.
+        unsafe { processed.write(0) };
+    }
+    let Some(tls) = connection.tls.as_mut() else {
+        return PROTOCOL;
+    };
+    if data.is_null() || length == 0 {
+        return PARAM;
+    }
+    // SAFETY: readable for `length`, per the caller.
+    let bytes = unsafe { std::slice::from_raw_parts(data as *const u8, length) };
+
+    let mut written = 0;
+    while written < bytes.len() {
+        match tls.writer().write(&bytes[written..]) {
+            Ok(0) => break,
+            Ok(n) => written += n,
+            Err(_) => return CRYPTO,
+        }
+    }
+    connection.drain_tls();
+    let status = connection.flush();
+    if status != OK {
+        return status;
+    }
+
+    if !processed.is_null() {
+        // SAFETY: writable, per the caller.
+        unsafe { processed.write(written) };
+    }
+    if written == bytes.len() {
+        OK
+    } else {
+        WOULD_BLOCK
+    }
+}
